# Backend API URL (for production deployment)
# The code automatically adds /api suffix if missing
# You can set it with or without /api - both will work

# Option 1: With /api suffix (recommended)
VITE_API_URL=https://gigflowbackend-saxu.onrender.com/api

# Option 2: Without /api suffix (will be added automatically)
# VITE_API_URL=https://gigflowbackend-saxu.onrender.com

# For local development, comment this out or leave empty
# It will use the Vite proxy to http://localhost:5000/api
# VITE_API_URL=
